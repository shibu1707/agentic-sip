{
  "openapi": "3.1.0",
  "info": {
    "title": "SIP Investment Agent API",
    "description": "API for filling and submitting SIP (Systematic Investment Plan) forms using AI",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://0d8d-103-47-32-206.ngrok-free.app"
    }
  ],
  "paths": {
    "/api/agent": {
      "post": {
        "operationId": "fillSIPForm",
        "summary": "Extract SIP details from user prompt and fill the form",
        "description": "Takes a natural language prompt describing a SIP investment and returns structured form data with all extracted fields.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "description": "Natural language description of the SIP the user wants to set up"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SIP form data extracted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "formData": {
                      "type": "object",
                      "properties": {
                        "fund_name": { "type": "string" },
                        "fund_category": { "type": "string" },
                        "amount": { "type": "number" },
                        "frequency": { "type": "string" },
                        "duration_months": { "type": "number" },
                        "start_date": { "type": "string" },
                        "goal": { "type": "string" }
                      }
                    },
                    "summary": {
                      "type": "string",
                      "description": "Human-readable summary of what was filled"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - prompt missing"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  }
}
